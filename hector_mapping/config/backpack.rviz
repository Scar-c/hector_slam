Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 36; 42; 52
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 75; 85; 100
    - Class: rviz_default_plugins/Map
      Name: Hector Map (LiDAR + IMU)
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Use Timestamp: false
    - Class: rviz_default_plugins/LaserScan
      Name: Horizontal Laser
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 90; 55
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Path
      Name: Hector Trajectory
      Enabled: true
      Topic:
        Value: /hector_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 25; 210; 240
      Line Style: Lines
      Line Width: 0.08
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/TF
      Name: IMU Corrected Frames
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 1
      Frame Timeout: 30
      Frames:
        All Enabled: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 6
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1400
  Height: 950
  X: 80
  Y: 40
