<?xml version="1.0"?>
<package format="3">
  <name>hector_cloud_frontend</name>
  <version>0.6.0</version>
  <description>Exact-time XYZ, gravity and voxel frontend for Hector mapping and fixed-prior EKF localization.</description>
  <maintainer email="241061258+Scar-c@users.noreply.github.com">Scar-c</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/Scar-c/hector_slam</url>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hector_mapping</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>hector_backend_core</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
