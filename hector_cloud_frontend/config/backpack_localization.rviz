Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 829
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /Interact1
  - /Measure1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: Hector matching input
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Hector fixed-map localization trajectory
    Topic:
      Value: /hector_path
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color: 0; 220; 0
    Line Width: 0.04
    Line Style: Lines
    Alpha: 1
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Enabled: true
    Name: Hector matching input
    Topic:
      Value: /hector_matching_points
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Queue Size: 20
    Style: Flat Squares
    Size (m): 0.045
    Size (Pixels): 3
    Alpha: 1
    Color Transformer: FlatColor
    Color: 0; 255; 255
    Position Transformer: XYZ
    Decay Time: 0
    Selectable: true
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Enabled: false
    Name: Deskewed input XYZ (optional)
    Topic:
      Value: /points_carto
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Queue Size: 20
    Style: Flat Squares
    Size (m): 0.045
    Size (Pixels): 3
    Alpha: 1
    Color Transformer: FlatColor
    Color: 255; 170; 0
    Position Transformer: XYZ
    Decay Time: 0
    Selectable: true
    Use Fixed Frame: true
    Value: false
  - Class: rviz_default_plugins/PointCloud2
    Enabled: false
    Name: Raw input XYZ (optional)
    Topic:
      Value: /points_carto_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Queue Size: 20
    Style: Flat Squares
    Size (m): 0.045
    Size (Pixels): 3
    Alpha: 1
    Color Transformer: FlatColor
    Color: 200; 200; 200
    Position Transformer: XYZ
    Decay Time: 0
    Selectable: true
    Use Fixed Frame: true
    Value: false
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: Fixed prior (no map updates)
    Topic:
      Value: /map
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Alpha: 1
    Color Scheme: map
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -0.4399998188018799
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 78.94898223876953
      Target Frame: map
      Value: TopDownOrtho (rviz_default_plugins)
      X: 1.3123466968536377
      Y: -1.375713586807251
    Saved:
    - Angle: 0.0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Complete prior and localization
      Near Clip Distance: 0.009999999776482582
      Scale: 4.0
      Target Frame: map
      Value: TopDownOrtho (rviz_default_plugins)
      X: -35.0
      Y: 35.0
Window Geometry:
  Displays:
    collapsed: false
  Height: 1131
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1854
  X: 66
  Y: 32
